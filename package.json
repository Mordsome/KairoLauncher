{
  "name": "kairo-launcher",
  "productName": "Kairo Launcher",
  "version": "0.1.0",
  "description": "Desktop launcher for the Kairo Minecraft clients.",
  "author": "Mordsome",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/Mordsome/KairoLauncher",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mordsome/KairoLauncher.git"
  },
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "dev:offline": "electron-vite dev --mode offline",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "test:e2e": "electron-vite build && playwright test",
    "test:launch": "electron-vite build --mode offline && playwright test -c playwright.launch.config.ts"
  },
  "devDependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.2",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "zustand": "^5.0.16"
  },
  "overrides": {
    "@xmcl/unzip": {
      "@xmcl/yauzl": "^2.10.0"
    }
  },
  "dependencies": {
    "@xmcl/core": "^2.16.3",
    "@xmcl/file-transfer": "^2.1.4",
    "@xmcl/installer": "^6.3.7",
    "undici": "^7.30.1"
  }
}
